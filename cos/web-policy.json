{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": ["name/cos:GetObject", "name/cos:HeadObject", "name/cos:PutObject", "name/cos:OptionsObject"],
      "resource": ["qcs::cos:<地域>:uid/<APPID>:<存储桶名称>/*"]
    },
    {
      "effect": "allow",
      "action": ["name/cos:GetBucket"],
      "resource": ["qcs::cos:<地域>:uid/<APPID>:<存储桶名称>/"]
    }
  ]
}
